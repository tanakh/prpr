// Self-definition of prpr syntax

```
use crate::syntax::*;
```

pub syntax: Syntax
    = (r:rule { Item::Rule(r) } / r:raw_code { Item::RawCode(r) })* !.

atom raw_code: String
    = "```" code:(!"```" .)* "```" { #code.to_string() }

rule: Rule
    = is_pub:"pub"? is_atom:"atom"? var:ident ty:(":" ty)? help:("?" string_lit)? "=" body:expr {
        Rule {
            is_pub: is_pub.is_some(),
            is_atom: is_atom.is_some(),
            var,
            ty,
            help,
            body,
        }
    }

expr: Expr = choice

choice: Expr = exprs:(semantic, "/")+ { Expr::Choice{ exprs, span: @_ } }

semantic: Expr
    = e:seq pred:"&"? "{" code:code "}"
        { Expr::Semantic{ expr: e.into(), pred: pred.is_some(), code, span: @_ } }
    / seq

seq: Expr = exprs:(named, !rule)+ { Expr::Seq{ exprs, span: @_ } }

named: Expr
    = var:ident ":" e:pred { Expr::Named{ var, expr: e.into(), span: @_ } }
    / pred

pred: Expr
    = "&" e:rep { Expr::And{ expr: e.into(), span: @_ } }
    / "!" e:rep { Expr::Not{ expr: e.into(), span: @_ } }
    / rep

rep: Expr
    = e:term "*" { Expr::Many{ expr: e.into(), span: @_ } }
    / e:term "+" { Expr::Many1{ expr: e.into(), span: @_ } }
    / e:term "?" { Expr::Optional{ expr: e.into(), span: @_ } }
    / term

term: Expr
    = "(" expr ")"
    / "<" e:expr ">" { Expr::Atomic{ expr: e.into(), span: @_ } }
    / "(" e:expr "," sep:expr ")" "*" { Expr::SepBy{ expr: e.into(), sep: sep.into(), span: @_ } }
    / "(" e:expr "," sep:expr ")" "+" { Expr::SepBy1{ expr: e.into(), sep: sep.into(), span: @_ } }
    / pat:string_lit { Expr::String{ pat, span: @_ } }
    / char_class
    / "~" str_char_class
    / var:ident { Expr::NonTerminal{ var, span: @_ } }
    / "." { Expr::Any{ span: @_ } }

atom string_lit: String = "\"" cs:char_lit* "\"" { cs.into_iter().collect() }

atom char_lit: char
    = ![\\\"] [\u20-\u10FFFF]
    / "\\" esc

atom esc: char
    = "\\" { '\\' }
    / "\"" { '\"' }
    / "]" { ']' }
    / "n" { '\n' }
    / "t" { '\t' }
    / "r" { '\r' }
    / "u" s:hex* {
        std::char::from_u32(u32::from_str_radix(#s, 16).unwrap()).unwrap()
    }

atom char_class: Expr
    = "[" neg:"^"? ranges:char_range* "]" { Expr::CharClass{ neg: neg.is_some(), ranges, span: @_ } }

atom str_char_class: Expr
    = "\"[" neg:"^"? ranges:char_range* "]\"" { Expr::CharClass{ neg: neg.is_some(), ranges, span: @_ } }

atom char_range: (char, char)
    = !"]" l:char_lit whitespace* "-" whitespace* r:char_lit { (l, r) }
    / !"]" c:char_lit { (c, c) }

atom hex: char = [0-9a-fA-F]

atom ident: String
    = !reserved s:([a-zA-Z_] [a-zA-Z0-9_]*) { #s.to_string() }

ty: String = spaces s:type_str { #s.to_string() }

type_str
    = "(" (ty,  ",")* ")"
    / ("Fn" / "FnOnce" / "FnMut") "(" type_str* ")" ("->" type_str)?
    / "dyn" type_str
    / "&" ("'" ident)? type_str
    / type_path ("<" (ty, ",")* ">")?

type_path = (ident, "::")+

// FIXME: handle string literal (e.g. "{", "#")
atom code: Vec<Fragment>
    = fss:(
        "{" c:code "}" {
            vec![
                vec![Fragment::CodeFragment("{".to_string())],
                c,
                vec![Fragment::CodeFragment("}".to_string())],
            ].concat()
        }
        / "#" spaces v:ident { vec![Fragment::RawVar(v)] }
        / "@" spaces v:ident { vec![Fragment::SpanVar(v)] }
        / cs:(![{}#@] .)+ { vec![Fragment::CodeFragment(#cs.to_string())] }
    )* &"}" { fss.concat() }

reserved = "pub" / "atom"

atom comment ? "comment" = line_comment / block_comment

atom line_comment = "//" (!"\n" .)* ("\n" / eof)
atom block_comment = "/*" (&"/*" block_comment / !"*/" .)* "*/"
